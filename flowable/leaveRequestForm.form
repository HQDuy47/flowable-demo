{
  "key": "leaveRequestForm",
  "name": "Đơn xin nghỉ phép",
  "fields": [
    { "fieldType": "FormField", "id": "employeeName", "name": "Họ tên", "type": "text", "required": true },
    { "fieldType": "FormField", "id": "fromDate", "name": "Từ ngày", "type": "date", "required": true },
    { "fieldType": "FormField", "id": "toDate", "name": "Đến ngày", "type": "date", "required": true },
    { "fieldType": "FormField", "id": "handoverTo", "name": "Người bàn giao", "type": "text", "required": true },
    { "fieldType": "OptionFormField", "id": "leaveType", "name": "Loại nghỉ", "type": "dropdown", "required": true,
      "options": [{ "name": "Phép năm" }, { "name": "Nghỉ ốm" }, { "name": "Việc riêng" }] },
    { "fieldType": "FormField", "id": "reason", "name": "Lý do", "type": "multi-line-text" }
  ]
}
